{
  "files.associations": {
    "*.dbclient-js": "javascript",
    "*.mdx": "mdx",
    "eigen": "cpp",
    "fg_internal.h": "c"
  },
  "cmake.sourceDirectory": "/Users/swcho/projects/temp/observation_equations/codes/c++Examples",
  "cmake.cmakePath": "/Applications/CMake.app/Contents/bin/cmake",

  // ros_env 인터프리터를 기본으로 사용 (Interactive Window 커널 자동 선택)
  "python.defaultInterpreterPath": "/Users/swcho/.local/share/mamba/envs/ros_env/bin/python",

  // Interactive Window / Jupyter의 작업 디렉토리를 "실행하는 파일이 있는 폴더"로 설정.
  //  - 서브디렉토리 스크립트의 sys.path.insert(1, '..') 가 python-scripts 루트를 가리키게 됨
  //  - 생성되는 *_jacobian.h 파일이 스크립트 폴더에 떨어짐 (CLI 실행과 동일)
  "jupyter.notebookFileRoot": "${fileDirname}",

  // 커널 시작 시 util 모듈이 있는 python-scripts 루트를 sys.path에 주입.
  // (cwd 와 무관하게 tait_bryan_R_utils / quaternion_R_utils 등 import 보장)
  "jupyter.runStartupCommands": [
    "import sys; p = '/Users/swcho/projects/temp/observation_equations/codes/python-scripts'; sys.path.insert(0, p) if p not in sys.path else None"
  ],

  // 이 스크립트들은 sys.path.insert(1, '..') 가 import 보다 먼저 실행돼야 한다.
  // 전역 설정의 저장 시 자동 포맷 / Organize Imports 가 import 를 위로 끌어올려
  // sys.path 설정을 깨뜨리므로, 이 워크스페이스에서는 비활성화한다.
  "[python]": {
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    }
  }
}